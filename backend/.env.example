PORT=5000
NODE_ENV=development

# MongoDB - Required
# Local: mongodb://localhost:27017/servicepulse
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/servicepulse
MONGODB_URI=your_mongodb_connection_string

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# SMS Provider (Twilio) - Optional for pilot mode
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Email (Nodemailer) - Optional, for OTP and alerts (pilot mode logs to console if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=ServicePulse

# Frontend URL
FRONTEND_URL=http://localhost:3000
