{
  "name": "servicepulse-backend",
  "version": "1.0.0",
  "description": "ServicePulse Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "seed:reports": "tsx src/scripts/seedReports.ts",
    "migrate:otp-hash": "tsx src/scripts/migrate-otp-hash.ts",
    "fix:indexes": "tsx src/scripts/fix-user-indexes.ts",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run tests/integration/http.integration.test.ts",
    "test:validation": "vitest run tests/integration/auth.validation.test.ts",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.2.1",
    "nodemailer": "^8.0.0",
    "twilio": "^4.20.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.9",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.5"
  }
}
